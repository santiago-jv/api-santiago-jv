# ============================================================================
# api-santiago-jv (https://api.santiago-jv.tech)
# Never commit real secrets, prompts, or markdown knowledge files to Git.
# ============================================================================

PORT=4000
NODE_ENV=development

# 1. Server-to-Server Cryptographic Handshake & Cloudflare Origin Lock
INTERNAL_HMAC_SECRET=replace-with-64-char-random-hex-secret
CF_ORIGIN_SECRET=replace-with-64-char-random-hex-cloudflare-origin-secret
ALLOWED_ORIGINS=https://ai.santiago-jv.tech,https://www.santiago-jv.tech,http://localhost:4321,http://localhost:3000

# 2. PostgreSQL + pgvector (Local Docker port 5433 or Neon Postgres in Vercel)
DATABASE_URL=postgresql://santiago:santiago_rag_dev@localhost:5433/santiago_rag
PG_POOL_MAX=5

# 3. AI Providers & Embeddings (Google AI Studio + Groq Fallback)
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GROQ_MODEL_ID=openai/gpt-oss-120b
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# 4. Hybrid RAG Retrieval Tuning
RAG_CANDIDATE_POOL=20
RAG_MIN_SEMANTIC_SIMILARITY=0.32

# 5. Optional AI Gateway Routing (Cloudflare AI Gateway or Vercel AI Gateway)
CLOUDFLARE_AI_GATEWAY_GOOGLE_URL=
CLOUDFLARE_AI_GATEWAY_GROQ_URL=
AI_GATEWAY_MODEL=

# 6. Private System Prompt Injection (Zero Prompts/Markdowns in Public Git Repo)
# Generate with `npm run pack:secrets` from .private/system-prompt.txt
AGENT_SYSTEM_PROMPT_B64=

# 7. Edge & Application Rate Limiting
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_HOUR=30
