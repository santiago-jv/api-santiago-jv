# ============================================================================
# api-santiago-jv (https://api.santiago-jv.tech)
# Never commit real secrets, prompts, or markdown knowledge files to Git.
# Run `npm run pack:secrets` locally to encode .private/* into Base64 env vars.
# ============================================================================

PORT=4000
NODE_ENV=development

# 1. Server-to-Server Cryptographic Handshake (Shared only with ai.santiago-jv.tech)
INTERNAL_HMAC_SECRET=replace-with-64-char-random-hex-secret
ALLOWED_ORIGINS=https://ai.santiago-jv.tech,https://www.santiago-jv.tech,http://localhost:4321,http://localhost:3000

# 2. Free AI Providers (Google AI Studio Free Tier + Groq Free Tier Fallback)
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GROQ_MODEL_ID=openai/gpt-oss-120b

# 3. Optional AI Gateway Routing (Cloudflare AI Gateway or Vercel AI Gateway)
# Example Cloudflare AI Gateway URLs:
# CLOUDFLARE_AI_GATEWAY_GOOGLE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_NAME>/google-ai-studio/v1beta
# CLOUDFLARE_AI_GATEWAY_GROQ_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_NAME>/groq/openai/v1
CLOUDFLARE_AI_GATEWAY_GOOGLE_URL=
CLOUDFLARE_AI_GATEWAY_GROQ_URL=
AI_GATEWAY_MODEL=

# 4. Private System Prompt & Knowledge Base Injection (Zero Prompts/Markdowns in Public Git Repo)
# Generate these with `npm run pack:secrets` from your local .private/ folder,
# OR provide a private URL (e.g. secret GitHub Gist raw URL) in KNOWLEDGE_BASE_URL.
AGENT_SYSTEM_PROMPT_B64=
KNOWLEDGE_BASE_MD_B64=
KNOWLEDGE_BASE_URL=
KNOWLEDGE_BASE_BEARER_TOKEN=

# 5. Edge & Application Rate Limiting
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_HOUR=30
