{
  "name": "api-santiago-jv",
  "version": "1.0.0",
  "description": "Official NestJS + @nestjs/ai Agent Backend for Santiago Olayo Villamil (api.santiago-jv.tech)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
